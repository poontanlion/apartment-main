# ============================================================
# EXAMPLE ONLY — do not put real values here.
# The real secret is created by .github/workflows/deploy-k8s.yml
# from GitHub Secrets (DB_USERNAME, DB_PASSWORD, ADMIN_EMAIL, ADMIN_PASSWORD).
#
# Manual alternative:
#   kubectl create secret generic apartment-db-secret \
#     --from-literal=DB_USERNAME=... --from-literal=DB_PASSWORD=... \
#     --from-literal=POSTGRES_DB=apartmentdb \
#     --from-literal=POSTGRES_USER=... --from-literal=POSTGRES_PASSWORD=... \
#     --from-literal=ADMIN_EMAIL=... --from-literal=ADMIN_PASSWORD=...
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: apartment-db-secret
type: Opaque
stringData:
  # Used by the backend
  DB_USERNAME: "<db-username>"
  DB_PASSWORD: "<db-password>"
  ADMIN_EMAIL: "<admin-email>"
  ADMIN_PASSWORD: "<admin-password>"
  # Used by the postgres container (must match DB_USERNAME / DB_PASSWORD)
  POSTGRES_DB: "apartmentdb"
  POSTGRES_USER: "<db-username>"
  POSTGRES_PASSWORD: "<db-password>"
