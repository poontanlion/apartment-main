# Copy to .env and change the values (.env is gitignored)

# Shared development PostgreSQL (Docker and local use the same volume).
# Set credentials before initializing a new volume; existing volumes keep them.
DB_USERNAME=apartment
DB_PASSWORD=apartment
LOCAL_POSTGRES_PORT=5433

# Local backend; Docker explicitly uses 8080 inside its network.
SERVER_PORT=8083

# Initial admin account
ADMIN_EMAIL=admin@victoryapartment.com
ADMIN_PASSWORD=change-me
